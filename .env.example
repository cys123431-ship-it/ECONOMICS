FRED_API_KEY=
ECOS_API_KEY=
KRX_API_KEY=
# OFR FSI, NY Fed dealer fails, Fed SCOOS and BIS global liquidity are built in.
# Optional generic JSON adapters are only needed for additional CFTC/TIC/FSC feeds.
# Copy config/official_adapters.example.json, replace its documented endpoints, then set this path.
OFFICIAL_ADAPTERS_FILE=
ECONOMICS_DB=runtime/economics.db
ECONOMICS_RULEBOOK=rulebook/Market_Economy_Radar_Rulebook_v4_ULTRA.txt
ECONOMICS_HOST=127.0.0.1:8765
ECONOMICS_MIN_SAMPLES=20
ECONOMICS_HTTP_TIMEOUT_SECS=30
ECONOMICS_KRX_LOOKBACK_DAYS=60
# Public Binance market data: short cadence, still far below documented request-weight limits.
ECONOMICS_CRYPTO_REFRESH_SECONDS=30
# Current FRED/Treasury and newest-published KRX daily rows.
ECONOMICS_REFRESH_MINUTES=5
# ECOS macro data does not need second-level polling.
ECONOMICS_MACRO_REFRESH_MINUTES=30
# Full KRX history and configured official adapters.
ECONOMICS_FULL_REFRESH_HOURS=6
