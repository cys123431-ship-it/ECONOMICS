FRED_API_KEY=
ECOS_API_KEY=
KRX_API_KEY=
# Optional generic JSON adapters for OFR/NY Fed/CFTC/TIC/BIS/FSC and other official feeds.
# Copy config/official_adapters.example.json, replace its documented endpoints, then set this path.
OFFICIAL_ADAPTERS_FILE=
ECONOMICS_DB=runtime/economics.db
ECONOMICS_RULEBOOK=rulebook/Market_Economy_Radar_Rulebook_v4_ULTRA.txt
ECONOMICS_HOST=127.0.0.1:8765
ECONOMICS_MIN_SAMPLES=20
ECONOMICS_HTTP_TIMEOUT_SECS=30
ECONOMICS_KRX_LOOKBACK_DAYS=60
# Fast sources are checked every 15 minutes; ECOS/KRX/ALFRED and adapters every 6 hours.
ECONOMICS_REFRESH_MINUTES=15
ECONOMICS_FULL_REFRESH_HOURS=6
